# ═══════════════════════════════════════════════════════════
# PeoplePay360 — Environment Configuration Example
# ═══════════════════════════════════════════════════════════

# Server
NODE_ENV=development
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=peoplepay360
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your-secure-jwt-secret-at-least-32-characters-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=your-secure-refresh-secret-at-least-32-characters
JWT_REFRESH_EXPIRY=7d

# Email (SMTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=payroll@peoplepay360.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Company
COMPANY_NAME=PeoplePay360
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
MIN_WAGE=15000
