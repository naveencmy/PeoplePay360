{
  "name": "peoplepay360-backend",
  "version": "1.0.0",
  "description": "PeoplePay360 — Production-grade Payroll Management System Backend",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "migrate": "node src/scripts/migrate.js",
    "seed": "node src/scripts/seed.js",
    "db:setup": "node src/scripts/migrate.js && node src/scripts/seed.js",
    "test": "jest --verbose --forceExit",
    "test:unit": "jest --testPathPattern=tests/unit --verbose --forceExit",
    "test:integration": "jest --testPathPattern=tests/integration --verbose --forceExit",
    "test:computation": "jest --testPathPattern=computation --verbose --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mathjs": "^13.1.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.0",
    "pg-boss": "^10.4.2",
    "prom-client": "^15.1.3",
    "uuid": "^10.0.0",
    "winston": "^3.14.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
