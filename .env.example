# ═══════════════════════════════════════════════════════════════════════════════
# PeoplePay360 — Production Environment Template
# ═══════════════════════════════════════════════════════════════════════════════

# Node / Express
NODE_ENV=production
PORT=3000

# PostgreSQL 16
DB_HOST=db
DB_PORT=5432
DB_NAME=peoplepay360
DB_USER=postgres
DB_PASSWORD=replace_with_strong_production_password_64char
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=20

# Redis 7
REDIS_HOST=cache
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Security Secrets (Generate using: openssl rand -base64 32)
JWT_SECRET=replace_with_strong_production_jwt_secret_key_32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_strong_production_refresh_secret_32chars
JWT_REFRESH_EXPIRY=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Company Defaults
COMPANY_NAME=PeoplePay360 Global
CURRENCY_CODE=INR
CURRENCY_SYMBOL=₹
MIN_WAGE=15000
